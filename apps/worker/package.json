{
  "name": "@annexevoice/worker",
  "version": "0.1.0",
  "private": true,
  "description": "AnnexEvoice BullMQ worker",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
