    "@nestjs/core": "^10.4.7",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.26.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "playwright": "^1.49.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@annexevoice/config": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
