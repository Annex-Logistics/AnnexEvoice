# AnnexEvoice — environment variables
# Copy to .env (LF line endings). Never commit real values.
# Dev defaults use *_PROVIDER=mock so the stack runs end-to-end without real credentials.

NODE_ENV=development
TZ=Africa/Lagos

# Public URLs
APP_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174
API_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://annexevoice:annexevoice@localhost:5432/annexevoice?schema=public
POSTGRES_USER=annexevoice
POSTGRES_PASSWORD=annexevoice
POSTGRES_DB=annexevoice

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# PII field-level encryption (32-byte base64)
PII_ENCRYPTION_KEY=ZGV2LXBpaS1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcy0hIQ==

# Provider selection (mock | real)
EINVOICE_PROVIDER=mock
WHATSAPP_PROVIDER=mock
PAYMENT_PROVIDER=mock
PAYMENT_FALLBACK_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
KYC_PROVIDER=mock
BANK_FEED_PROVIDER=mock
STORAGE_PROVIDER=mock
ACCOUNTING_PROVIDER=mock
LLM_PARSER_ENABLED=false

# NRS / APP (populate when spec received)
EINVOICE_APP_BASE_URL=
EINVOICE_APP_CLIENT_ID=
EINVOICE_APP_CLIENT_SECRET=
EINVOICE_APP_WEBHOOK_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_BUSINESS_NUMBER=+2348000000000

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Flutterwave (fallback)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Mono bank feeds
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=

# KYC — TIN / CAC
KYC_API_KEY=

# SMS — Termii primary, Africa's Talking fallback
TERMII_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# Email — ZeptoMail primary, Resend fallback
EMAIL_FROM="AnnexEvoice <no-reply@annexevoice.ng>"
ZEPTOMAIL_API_KEY=
RESEND_API_KEY=

# Google Cloud
GCP_PROJECT_ID=annexevoice-dev
GCS_BUCKET_INVOICES=annexevoice-invoices-dev
GOOGLE_APPLICATION_CREDENTIALS=

# LLM fallback (feature-flagged)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-7
LLM_TENANT_MONTHLY_CAP_USD=10

# Accounting sync (OAuth clients)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=

# Observability
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Feature flags
FEATURE_WHATSAPP_INVOICING=true
FEATURE_ACCOUNTING_SYNC=false
FEATURE_PUBLIC_API=true
